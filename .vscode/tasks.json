		{
			"label": "Verify legacy PPT extraction",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const PPT=require('ppt-to-text'); const CFB=require('cfb'); const rec=(type,body,ver=0)=>{const h=Buffer.alloc(8);h.writeUInt16LE(ver,0);h.writeUInt16LE(type,2);h.writeUInt32LE(body.length,4);return Buffer.concat([h,body]);};const text=rec(0x0FA0,Buffer.from('Legacy PowerPoint extraction contains sufficient educational slide text for this parser integration test.','utf16le'));const textbox=rec(0xF00D,text,0xF);const shape=rec(0xF004,textbox,0xF);const group=rec(0xF003,shape,0xF);const drawing=rec(0x040C,rec(0xF002,group,0xF));const slide=rec(0x03EE,drawing);const editBody=Buffer.alloc(16);editBody.writeUInt32LE(slide.length+24,12);const persist=rec(0x1772,Buffer.alloc(0));const pptDocument=Buffer.concat([slide,rec(0x0FF5,editBody),persist]);const currentUserBody=Buffer.alloc(12);const currentUser=rec(0x0FF6,currentUserBody);const cfb=CFB.utils.cfb_new();CFB.utils.cfb_add(cfb,'Current User',currentUser);CFB.utils.cfb_add(cfb,'PowerPoint Document',pptDocument);const buffer=CFB.write(cfb,{type:'buffer'});const parsed=PPT.utils.to_text(PPT.readBuffer(buffer));if(!parsed[0]?.includes('Legacy PowerPoint extraction'))throw new Error(JSON.stringify(parsed));console.log(JSON.stringify({slides:parsed.length,firstSlide:parsed[0]}));"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Legacy PPT parser integration check",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const PPT=require(\"ppt-to-text\"); const CFB=require(\"cfb\"); const rec=(type,body,ver=0)=>{const h=Buffer.alloc(8);h.writeUInt16LE(ver,0);h.writeUInt16LE(type,2);h.writeUInt32LE(body.length,4);return Buffer.concat([h,body]);};const text=rec(0x0FA0,Buffer.from(\"Legacy PowerPoint extraction contains sufficient educational slide text for this parser integration test.\",\"utf16le\"));const textbox=rec(0xF00D,text,0xF);const shape=rec(0xF004,textbox,0xF);const group=rec(0xF003,shape,0xF);const drawing=rec(0x040C,rec(0xF002,group,0xF));const slide=rec(0x03EE,drawing);const editBody=Buffer.alloc(16);editBody.writeUInt32LE(slide.length+24,12);const persist=rec(0x1772,Buffer.alloc(0));const pptDocument=Buffer.concat([slide,rec(0x0FF5,editBody),persist]);const currentUserBody=Buffer.alloc(12);const currentUser=rec(0x0FF6,currentUserBody);const cfb=CFB.utils.cfb_new();CFB.utils.cfb_add(cfb,\"Current User\",currentUser);CFB.utils.cfb_add(cfb,\"PowerPoint Document\",pptDocument);const buffer=CFB.write(cfb,{type:\"buffer\"});const parsed=PPT.utils.to_text(PPT.readBuffer(buffer));if(!parsed[0]?.includes(\"Legacy PowerPoint extraction\"))throw new Error(JSON.stringify(parsed));console.log(JSON.stringify({slides:parsed.length,firstSlide:parsed[0]}));"
			],
