NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/learngate
MONGODB_DATABASE=learngate
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
COOKIE_NAME=learngate_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
FACULTY_ACCESS_CODE=
RESEND_API_KEY=
MAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_MONTHLY_GENERATION_CAP=20
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX=5
DOCUMENT_MAX_SIZE_MB=20
QUIZ_DEFAULT_TIME_LIMIT_SECONDS=600
QUIZ_DEFAULT_PASSING_SCORE=75
QUIZ_MAX_QUESTIONS=20
